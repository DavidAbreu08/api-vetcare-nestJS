# Copy to .env.mssql.local; the existing MySQL .env is not loaded by default.
TYPEORM_CONNECTION=mssql
TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=1433
TYPEORM_USERNAME=vetcare_migrator
TYPEORM_PASSWORD=
TYPEORM_DATABASE=vetcare_dev
TYPEORM_ENCRYPT=true
# Development only, when using a local self-signed SQL Server certificate.
TYPEORM_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET_KEY=
FRONTEND_URL=http://localhost:4200
# Express trust proxy (client IP for rate limiting). Default off. Number of hops (e.g. 1), true (trust all:
# only if the proxy always overwrites X-Forwarded-For) or comma-separated proxy IPs/subnets (e.g. 10.0.0.0/8).
# TODO(deploy): when the API runs behind a proxy/load balancer/cloud (nginx, IIS ARR, Azure App Service,
# Cloudflare...), set TRUST_PROXY (usually 1, matching the number of proxies in front). Without it every user
# shares the proxy IP, so the per-IP rate limit of forgot/reset-password blocks password recovery for everyone.
# A proxy in production is likely: validate this on deploy.
TRUST_PROXY=
# Optional: defaults to enabled outside production; false disables /docs and /docs-json.
SWAGGER_ENABLED=true
EMAIL_USER=
EMAIL_PASSWORD=

# Used only by the explicit npm run db:seed:admin command. Never committed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador local
